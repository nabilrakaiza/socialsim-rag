# Copy to .env and fill in. All three are required for ingest, eval and the app.

# Supabase project URL and service role key.
#   Local stack (`supabase start`): run `supabase status`, use "API URL" and "service_role key".
#   Hosted project: Dashboard > Project Settings > API.
# The service role key bypasses row-level security. Server-side only, never commit it.
SUPABASE_URL=http://127.0.0.1:54321
SERVICE_ROLE=

# Google AI Studio key (free tier is enough): https://aistudio.google.com/apikey
# Used for gemini-embedding-001 (retrieval) and the dialogue/batch models.
GOOGLE_API_KEY=

# Optional. Only checked by GET /api/cron/keepalive, when deployed on Vercel.
CRON_SECRET=
